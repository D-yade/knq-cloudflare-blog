---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<nav class="footer-links" aria-label="フッターナビゲーション">
			<a href="/about/">このブログについて</a>
			<a href="/privacy/">プライバシーポリシー</a>
			<a href="/contact/">お問い合わせ</a>
		</nav>

		<p class="copyright">
			&copy; {today.getFullYear()} 気になるニュースブログ
		</p>
	</div>
</footer>

<style>
	footer {
		padding: 42px 20px 50px;
		background: #ffffff;
		border-top: 1px solid #e7eaf0;
		color: #6b7280;
		text-align: center;
	}

	.footer-inner {
		max-width: 1000px;
		margin: 0 auto;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px 24px;
		margin-bottom: 20px;
		font-size: 0.9rem;
	}

	.footer-links a {
		color: #557199;
		text-decoration: none;
	}

	.footer-links a:hover {
		text-decoration: underline;
	}

	.copyright {
		margin: 0;
		font-size: 0.82rem;
	}

	@media (max-width: 600px) {
		footer {
			padding: 34px 16px 40px;
		}

		.footer-links {
			flex-direction: column;
			gap: 10px;
		}
	}
</style>